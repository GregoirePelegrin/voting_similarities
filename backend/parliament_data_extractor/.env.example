# Source-prefixed database name: DB_{SOURCE}_NAME
DB_FR_ASSEMBLEE_NATIONALE_NAME=fr_assemblee_nationale
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# LLM categorization (used by `parse` and `parse --recategorize`)
# Default is a local Ollama-compatible server. For free-tier Groq:
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_API_KEY=<groq key>
# Non-reasoning Groq model recommended (no hidden chain-of-thought tokens):
#   qwen/qwen3.8-27b (free, fast). gpt-oss-20b/120b work too but spend
#   ~100-150 tokens on reasoning before the answer.
LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=
LLM_MODEL_SMALL=llama-3.1-8b-instant
LLM_MODEL_BIG=qwen/qwen3.8-27b
LLM_MAX_TOKENS=200
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3