# Static config for batch/update-data.sh — secrets & dynamic values injected by the workflow
# Postgres superuser (shared with deploy-production.sh / postgres container)
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_HOST=localhost
DB_PORT=5432

# Extractor database (source-prefixed), created once via `init-db --source fr_assemblee_nationale`
DB_FR_ASSEMBLEE_NATIONALE_NAME=fr_assemblee_nationale

# LLM categorisation — Groq free tier by default
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_BIG=qwen/qwen3.8-27b
# LLM_MODEL_SMALL=llama-3.1-8b-instant
# LLM_MAX_TOKENS=200
# LLM_TEMPERATURE=0.7
# LLM_TIMEOUT=60
# LLM_MAX_RETRIES=3